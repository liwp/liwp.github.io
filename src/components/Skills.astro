---
import { skills } from '../data/resume';

const BLOCKS = 10;
---

<section class="section wrap" id="skills">
  <div class="section-head">
    <span class="addr">[0x03]</span>
    <h2 data-scramble>./skills</h2>
    <span class="line-fill" aria-hidden="true"></span>
    <span class="count">{skills.reduce((n, g) => n + g.items.length, 0)} pkgs</span>
  </div>

  <div class="pkg-grid">
    {
      skills.map((group) => (
        <div class="pkg-group" data-print>
          <span class="cat label">## {group.category.toLowerCase()}</span>
          {group.items.map((item) => (
            <div class="pkg">
              <span class="name">{item.name}</span>
              <span
                class="gauge"
                data-bar
                role="img"
                aria-label={`${item.name}: ${item.level} out of ${BLOCKS}`}
              >
                {Array.from({ length: BLOCKS }, (_, i) => (
                  <i class={i < item.level ? 'on' : 'off'} />
                ))}
              </span>
              <span class="ver label">[{item.level}/{BLOCKS}]</span>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .pkg-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 5rem);
  }

  .pkg-group {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .cat {
    color: var(--amber);
    margin-block-end: 0.4rem;
  }

  .pkg {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gauge {
    display: inline-flex;
    gap: 3px;
  }

  .gauge i {
    width: 0.45em;
    height: 0.95em;
  }

  .gauge .on {
    background: var(--green);
    box-shadow: 0 0 6px rgba(59, 255, 118, 0.4);
  }

  .gauge .off {
    background: rgba(59, 255, 118, 0.12);
  }

  .ver {
    color: var(--green-dim);
    min-width: 4.5ch;
    text-align: right;
  }

  @media (max-width: 880px) {
    .pkg-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .gauge i {
      width: 0.38em;
    }
  }
</style>
