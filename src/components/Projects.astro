---
import { projects } from '../data/resume';

const flag = (tag: string) => '--' + tag.toLowerCase().replace(/[^a-z0-9+#]+/g, '-');
---

<section class="section wrap" id="projects">
  <div class="section-head">
    <span class="addr">[0x03]</span>
    <h2 data-scramble>./projects</h2>
    <span class="line-fill" aria-hidden="true"></span>
    <span class="count">{projects.length} projects</span>
  </div>

  <div class="grid">
    {
      projects.map((project) =>
        project.url ? (
          <a class="daemon" href={project.url} target="_blank" rel="noopener noreferrer" data-print>
            <div class="d-head">
              <h3 data-hover-scramble>{project.name}</h3>
              <span class="status label">[{project.status}]</span>
            </div>
            <p>{project.description}</p>
            <div class="flags label">
              {project.stack.map((tech) => (
                <span>{flag(tech)}</span>
              ))}
            </div>
          </a>
        ) : (
          <div class="daemon" data-print>
            <div class="d-head">
              <h3 data-hover-scramble>{project.name}</h3>
              <span class="status label">[{project.status}]</span>
            </div>
            <p>{project.description}</p>
            <div class="flags label">
              {project.stack.map((tech) => (
                <span>{flag(tech)}</span>
              ))}
            </div>
          </div>
        )
      )
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .daemon {
    border-inline-start: 1px solid var(--line);
    padding-inline-start: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .daemon:hover {
    border-color: var(--green);
    background: linear-gradient(90deg, rgba(59, 255, 118, 0.05), transparent 60%);
  }

  .daemon:hover h3 {
    text-shadow: var(--glow);
  }

  .d-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--step-lg);
    font-weight: 700;
    color: var(--green);
    line-height: 1.2;
  }

  .status {
    margin-inline-start: auto;
    color: var(--green-dim);
    transition: color 0.3s ease;
  }

  .daemon:hover .status {
    color: var(--amber);
  }

  .daemon p {
    color: var(--green-soft);
    font-size: var(--step-md);
  }

  .flags {
    margin-block-start: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    color: var(--green-dim);
  }

  @media (max-width: 880px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
